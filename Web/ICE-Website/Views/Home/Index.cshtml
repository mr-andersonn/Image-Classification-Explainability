@model ICE_Website.Models.ExplainabilityModel

@{
    ViewData["Title"] = "Fish Classifier Explainability";
}

<div class="container mt-5">
    <h1 class="mb-4">Fish Classifier Explainability</h1>

    <form asp-action="Index"
          asp-controller="Home"
          method="post"
          enctype="multipart/form-data"
          class="mb-4">

        <div class="mb-3">
            <label asp-for="ImageFile" class="form-label">Upload image</label>
            <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
        </div>

        <button type="submit" class="btn btn-primary">
            Analyze Image
        </button>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.PredictedClass))
    {
        <section class="mt-4">
            <h2>Main Prediction</h2>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <p>
                        <strong>Predicted class:</strong>
                        @Model.PredictedClass
                    </p>
                    <p>
                        <strong>Confidence:</strong>
                        @((Model.Confidence ?? 0).ToString("P2"))
                    </p>
                </div>
            </div>
        </section>
    }

    @if (Model.AllPredictions.Any())
    {
        <section class="mt-4">
            <h2>All Predictions</h2>

            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Class</th>
                        <th>Confidence</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prediction in Model.AllPredictions.OrderByDescending(p => p.Confidence))
                    {
                        <tr>
                            <td>@prediction.ClassName</td>
                            <td>@prediction.Confidence.ToString("P2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(Model.HeatmapImage))
    {
        <section class="mt-5">
            <h2>Grad-CAM Heatmap</h2>

            <p class="text-muted">
                The heatmap shows which parts of the image contributed most to the predicted class.
            </p>

            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <img src="@Model.HeatmapImage"
                         alt="Grad-CAM heatmap"
                         class="img-fluid rounded border" />
                </div>
            </div>
        </section>
    }

    @if (Model.ActivationImages.Any())
    {
        <section class="mt-5">
            <h2>Intermediate Activations</h2>

            <p class="text-muted">
                These images show how convolutional layers respond to the uploaded image.
            </p>
            <p class="text-muted">
                Note: Since the model uses MobileNetV3Large backbone, which consists of 50+ convolutional layers, this demonstration only shows activations of the classification head layers.
            </p>

            @foreach (var activation in Model.ActivationImages)
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header">
                        <strong>@activation.LayerName</strong>
                    </div>

                    <div class="card-body text-center">
                        <img src="@activation.Image"
                             alt="Activation visualization for @activation.LayerName"
                             class="img-fluid rounded border" />
                    </div>
                </div>
            }
        </section>
    }
</div>